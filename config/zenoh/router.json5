// Zenoh router for chessbot: rmw_zenoh's router settings (where they differ from Zenoh's
// defaults) plus the REST plugin and an in-memory key-value store.
// Upstream: rmw_zenoh_cpp/config/DEFAULT_RMW_ZENOH_ROUTER_CONFIG.json5
{
  mode: "router",
  listen: {
    endpoints: ["tcp/[::]:7447"],
  },
  scouting: {
    multicast: { enabled: false },
  },
  queries_default_timeout: 600000,
  transport: {
    unicast: {
      open_timeout: 60000,
      accept_timeout: 60000,
      accept_pending: 10000,
      max_sessions: 10000,
    },
    link: {
      tx: {
        lease: 60000,
        keep_alive: 2,
      },
    },
    shared_memory: {
      enabled: true,
    },
  },
  adminspace: {
    enabled: true,
    permissions: { read: true, write: false },
  },
  plugins_loading: {
    enabled: true,
  },
  plugins: {
    rest: {
      http_port: 8080,
    },
    storage_manager: {
      storages: {
        chessbot_kv: {
          key_expr: "chessbot/kv/**",
          volume: { id: "memory" },
        },
      },
    },
  },
}
