<?xml version="1.0"?>
<!--
  The robot half of the real stack: the SO-101 through ros2_control, and the overhead and
  wrist USB cameras (usb_cam) as components in the io container, so frames reach
  perception and the Rerun bridge by pointer.

  Launched on its own it is a complete robot without any chessbot logic.
-->
<launch>
  <arg name="description_file" default="$(find-pkg-share chessbot_description)/urdf/so101.urdf.xacro" />
  <arg name="controllers_file" default="$(find-pkg-share chessbot_description)/config/controllers.yaml" />
  <arg name="container" default="robot_io" />
  <arg name="hardware" default="real" />
  <arg name="usb_port" default="/dev/so101" />
  <arg name="joint_config_file" default="$(env HOME)/.chessbot/so101_joints.yaml" />
  <arg name="cameras" default="true" />
  <arg name="overhead_xyz" default="0.234 0.0 0.51" />
  <arg name="overhead_rpy" default="3.14159 0.0 -1.5708" />

  <let name="robot_description"
       value="$(command 'xacro $(var description_file) hardware:=$(var hardware) usb_port:=$(var usb_port) joint_config_file:=$(var joint_config_file) overhead_xyz:=&quot;$(var overhead_xyz)&quot; overhead_rpy:=&quot;$(var overhead_rpy)&quot;')" />

  <node_container pkg="rclcpp_components" exec="component_container" name="$(var container)"
                  namespace="" args="--executor-type events-cbg" output="screen" />

  <group if="$(var cameras)">
    <load_composable_node target="$(var container)">
      <composable_node pkg="usb_cam" plugin="usb_cam::UsbCamNode" name="camera" namespace="overhead_camera">
        <param from="$(find-pkg-share chessbot_bringup)/config/cameras/overhead.yaml" />
        <param name="camera_info_url" value="file://$(find-pkg-share chessbot_bringup)/config/cameras/overhead_intrinsics.yaml" />
        <extra_arg name="use_intra_process_comms" value="true" />
      </composable_node>
      <composable_node pkg="usb_cam" plugin="usb_cam::UsbCamNode" name="camera" namespace="wrist_camera">
        <param from="$(find-pkg-share chessbot_bringup)/config/cameras/wrist.yaml" />
        <extra_arg name="use_intra_process_comms" value="true" />
      </composable_node>
    </load_composable_node>
  </group>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(var robot_description)" type="str" />
  </node>

  <node pkg="controller_manager" exec="ros2_control_node" name="controller_manager" output="screen">
    <param from="$(var controllers_file)" />
    <remap from="~/robot_description" to="/robot_description" />
  </node>

  <node pkg="controller_manager" exec="spawner" name="spawn_jsb" output="screen"
        args="joint_state_broadcaster --controller-manager /controller_manager --controller-manager-timeout 60 --param-file $(var controllers_file)" />
  <node pkg="controller_manager" exec="spawner" name="spawn_arm" output="screen"
        args="arm_controller --controller-manager /controller_manager --controller-manager-timeout 60 --param-file $(var controllers_file)" />
  <node pkg="controller_manager" exec="spawner" name="spawn_gripper" output="screen"
        args="gripper_controller --controller-manager /controller_manager --controller-manager-timeout 60 --param-file $(var controllers_file)" />
</launch>
