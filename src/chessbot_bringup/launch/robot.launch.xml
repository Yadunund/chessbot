<?xml version="1.0"?>
<!--
  The robot, simulated or real. Everything above it (the application) is the same either
  way, so this is the only place the two differ.

  hardware:=gazebo  the SO-101 in Gazebo, with simulated cameras
  hardware:=real    the SO-101 over USB (Feetech servos) and the USB cameras
  hardware:=mock    ros2_control's mock hardware: no arm, no cameras (dry run)

  Gazebo or the cameras, the ros_gz bridge and our C++ components share one container with
  intra-process comms, so camera frames are passed by pointer rather than serialised. The
  container uses the callback-group events executor, which scales better than the default
  when a process has many subscriptions.

  Launched on its own it is a complete robot without any chessbot logic, which makes it the
  thing to test when bringup misbehaves.
-->
<launch>
  <arg name="hardware" default="gazebo" description="gazebo, real or mock." />
  <arg name="container" default="robot_io" />
  <arg name="world" default="$(find-pkg-share chessbot_description)/worlds/chessbot.sdf" />
  <arg name="description_file" default="$(find-pkg-share chessbot_description)/urdf/so101.urdf.xacro" />
  <arg name="controllers_file" default="$(find-pkg-share chessbot_description)/config/controllers.yaml" />
  <arg name="cameras" default="true" description="Cameras: simulated or USB. False speeds up motion tests." />
  <arg name="usb_port" default="/dev/so101" description="Servo bus (hardware:=real)." />
  <arg name="joint_config_file" default=""
       description="Servo register overrides (hardware:=real). Empty uses what calibration wrote to the servos' own EEPROM, which is where it belongs." />
  <arg name="overhead_xyz" default="0.234 0.0 0.51" description="Overhead camera position in base_link, metres." />
  <arg name="overhead_rpy" default="3.14159 0.0 -1.5708" description="Overhead camera orientation (optical frame)." />

  <let name="simulated" value="$(eval '&quot;$(var hardware)&quot; == &quot;gazebo&quot;')" />

  <let name="robot_description"
       value="$(command 'xacro $(var description_file) hardware:=$(var hardware) cameras:=$(var cameras) controllers_file:=$(var controllers_file) usb_port:=&quot;$(var usb_port)&quot; joint_config_file:=&quot;$(var joint_config_file)&quot; overhead_xyz:=&quot;$(var overhead_xyz)&quot; overhead_rpy:=&quot;$(var overhead_rpy)&quot;')" />

  <node_container pkg="rclcpp_components" exec="component_container" name="$(var container)"
                  namespace="" args="--executor-type events-cbg" output="screen" />

  <!-- Simulated: Gazebo runs ros2_control itself, through the plugin in the description. -->
  <group if="$(var simulated)">
    <load_composable_node target="$(var container)">
      <composable_node pkg="ros_gz_sim" plugin="ros_gz_sim::GzServer" name="gz_server">
        <param name="world_sdf_file" value="$(var world)" />
        <param name="use_sim_time" value="true" />
      </composable_node>
      <composable_node pkg="ros_gz_bridge" plugin="ros_gz_bridge::RosGzBridge" name="gz_bridge">
        <param name="config_file" value="$(find-pkg-share chessbot_bringup)/config/gz_bridge.yaml" />
        <param name="use_sim_time" value="true" />
        <extra_arg name="use_intra_process_comms" value="true" />
      </composable_node>
    </load_composable_node>

    <!-- Spawn from the topic robot_state_publisher latches, rather than passing the URDF as
         an argument (it contains quotes the launch parser rejects). -->
    <node pkg="ros_gz_sim" exec="create" name="spawn_robot" output="screen"
          args="-topic robot_description -name so101 -allow_renaming true -z 0.0" />
  </group>

  <!-- Real or mock: we run ros2_control ourselves, and the cameras are USB devices. -->
  <group unless="$(var simulated)">
    <node pkg="controller_manager" exec="ros2_control_node" name="controller_manager" output="screen">
      <param from="$(var controllers_file)" />
      <remap from="~/robot_description" to="/robot_description" />
    </node>

    <group if="$(var cameras)">
      <load_composable_node target="$(var container)">
        <composable_node pkg="usb_cam" plugin="usb_cam::UsbCamNode" name="camera" namespace="overhead_camera">
          <param from="$(find-pkg-share chessbot_bringup)/config/cameras/overhead.yaml" />
          <param name="camera_info_url" value="file://$(find-pkg-share chessbot_bringup)/config/cameras/overhead_intrinsics.yaml" />
          <extra_arg name="use_intra_process_comms" value="true" />
        </composable_node>
        <composable_node pkg="usb_cam" plugin="usb_cam::UsbCamNode" name="camera" namespace="wrist_camera">
          <param from="$(find-pkg-share chessbot_bringup)/config/cameras/wrist.yaml" />
          <extra_arg name="use_intra_process_comms" value="true" />
        </composable_node>
      </load_composable_node>
    </group>
  </group>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(var robot_description)" type="str" />
    <param name="use_sim_time" value="$(var simulated)" />
  </node>

  <node pkg="controller_manager" exec="spawner" name="spawn_jsb" output="screen"
        args="joint_state_broadcaster --controller-manager /controller_manager --controller-manager-timeout 120 --param-file $(var controllers_file)" />
  <node pkg="controller_manager" exec="spawner" name="spawn_arm" output="screen"
        args="arm_controller --controller-manager /controller_manager --controller-manager-timeout 120 --param-file $(var controllers_file)" />
  <node pkg="controller_manager" exec="spawner" name="spawn_gripper" output="screen"
        args="gripper_controller --controller-manager /controller_manager --controller-manager-timeout 120 --param-file $(var controllers_file)" />
</launch>
