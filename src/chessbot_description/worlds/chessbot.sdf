<?xml version="1.0" ?>
<!--
  Chessbot simulation world: a table surface for the robot to stand on, lighting
  bright enough for the cameras, and the systems the stack needs (sensors for
  camera rendering, ros2_control via the robot's plugin, contacts for grasping).

  The board and pieces are not modelled yet; the robot and cameras come first.
-->
<sdf version="1.9">
  <world name="chessbot">

    <!-- This simulation runs at about a third of real time, and the cost is collision
         checking against the arm's full detail collision meshes. Measured alternatives:
         Bullet's collision detector is worse here (0.20 against 0.32), and 4 ms steps do
         reach real time but make the grasp unreliable - a held piece tilts out of the jaws.
         So the step stays at 1 ms and the remaining fix is simpler collision geometry. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 3 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- A diffuse fill light from above the board keeps the overhead camera
         image even, the way the LED bar on the real mast will. -->
    <light type="point" name="board_fill">
      <pose>0.234 0 0.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <attenuation>
        <range>4</range>
        <constant>0.4</constant>
        <linear>0.2</linear>
      </attenuation>
    </light>

    <!-- Table surface: the robot's base plate and the board sit on this. -->
    <model name="table">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry>
            <box><size>1.2 1.2 0.02</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.28 0.22 1</ambient>
            <diffuse>0.55 0.44 0.34 1</diffuse>
          </material>
        </visual>
        <pose>0 0 -0.01 0 0 0</pose>
      </link>
    </model>

  </world>
</sdf>
