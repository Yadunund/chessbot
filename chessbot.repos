repositories:
  # Generic ROS 2 -> Rerun bridge (Apache-2.0), a composable node in robot_io.
  # Private for now: cloned over SSH, so it needs a GitHub key with access.
  rerun_ros_bridge:
    type: git
    url: git@github.com:Yadunund/rerun_ros_bridge.git
    version: 2d425a7e639047db0d199ddbac69d742a241b079
  # SO-101 URDF/xacro descriptions (BSD-3-Clause). Same pin as ros-physical-ai/demos.
  ros2_so_arm:
    type: git
    url: https://github.com/ros-physical-ai/ros2_so_arm.git
    version: 12fbcb8cf30da7c3d679db384c43765ea311eb18
  # Chess engine (GPL-3.0). Built from unmodified upstream source into a separate
  # executable and driven over UCI pipes only; never linked or vendored.
  # See docs/licensing.md. Tag sf_19.
  Stockfish:
    type: git
    url: https://github.com/official-stockfish/Stockfish.git
    version: edb0d9db6731067ec50ce619ff372b463bc4dd5d
